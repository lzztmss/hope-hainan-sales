# 复制为 .env 后再填写。不得把 .env 提交、发邮件或放入压缩包。
APP_VERSION=2.0.1-20260802
APP_ORIGIN=https://quote.example.com
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

POSTGRES_DB=hainan_fttr
POSTGRES_USER=hainan_fttr
POSTGRES_VOLUME_NAME=hainan_fttr_heartlink_postgres_data
POSTGRES_PASSWORD=<请使用至少32位随机字母数字下划线或短横线>

# 两个密钥必须各自是 32 随机字节的 Base64，且不能相同。
PII_ENCRYPTION_KEY_BASE64=<openssl-rand-base64-32>
PII_LOOKUP_HMAC_KEY_BASE64=<openssl-rand-base64-32>

BOOTSTRAP_ADMIN_USERNAME=ADMIN001
BOOTSTRAP_ADMIN_PASSWORD=<请使用至尖16位强初始密码>

BACKUP_ENCRYPTION_PASSPHRASE=<请使用至尓2位随机备份口令>
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
