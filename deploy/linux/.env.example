# 复制为 .env 后再填写。不得把 .env 提交到 Git、发邮件或通过普通通讯工具发送。
APP_VERSION=1.0.0
APP_ORIGIN=https://quote.example.com
# 独立域名部署填 /；挂在现有站点子路径时填写如 /hainan-sales/
APP_BASE_PATH=/
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

SQLITE_VOLUME_NAME=hainan_fttr_heartlink_sqlite_data

# 两个密钥必须各自是 32 随机字节的 Base64，且不能相同。
PII_ENCRYPTION_KEY_BASE64=<openssl-rand-base64-32>
PII_LOOKUP_HMAC_KEY_BASE64=<openssl-rand-base64-32>

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<请使用至少16位强初始密码>

BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
