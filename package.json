{
  "name": "hainan-fttr-heartlink-sales",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "dev": "concurrently -k -n web,api \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:test": "bash scripts/start-local-test.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "tsc --noEmit && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "build": "pnpm build:web && pnpm build:api",
    "start:api": "node dist-server/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:seed": "tsx server/db/seed.ts",
    "db:seed:acceptance": "tsx server/db/seedAcceptance.ts",
    "db:acceptance:order": "tsx scripts/acceptance-order-tools.ts",
    "db:backup": "tsx server/db/backup.ts backup",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@excel.js/exceljs": "0.15.0",
    "@fastify/cookie": "11.1.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@node-rs/argon2": "2.0.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "lucide-react": "^1.39.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.1",
    "shadcn": "^4.20.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "drizzle-kit": "0.31.10",
    "jsdom": "29.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
